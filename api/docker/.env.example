SPRING_PROFILES_ACTIVE=dev

POSTGRES_HOST=sophia-postgres
POSTGRES_PORT=5432
POSTGRES_DB=sophia
POSTGRES_USER=sophia
POSTGRES_PASSWORD=sophia

AUTHENTICATION_DB=sophia_authentication
DOCUMENT_WORKSPACE_DB=sophia_document_workspace
NOTIFICATION_DB=sophia_notification
AI_DB=sophia_ai

REDIS_HOST=sophia-redis
REDIS_PORT=6379
REDIS_SSL=false

KAFKA_BOOTSTRAP_SERVERS=sophia-kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TOPIC_REPLICAS=1

OPENSEARCH_HOST=sophia-opensearch
OPENSEARCH_PORT=9200

S3_ENDPOINT=http://sophia-minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AUTHENTICATION_S3_BUCKET=sophia-avatars
DOCUMENT_WORKSPACE_S3_BUCKET=sophia-documents

MAIL_HOST=sophia-mailhog
MAIL_PORT=1025
EMAIL_ENABLED=true
EMAIL_FROM=no-reply@sophia.local


NOTIFICATION_COMMANDS_TOPIC=sophia.notifications.commands
NOTIFICATION_COMMANDS_CONCURRENCY=3
USER_EVENTS_TOPIC=sophia.authentication.user-events
USER_EVENTS_DEAD_LETTER_TOPIC=sophia.authentication.user-events.dlt
USER_EVENTS_PARTITIONS=3
USER_EVENTS_CONCURRENCY=2
USER_EVENTS_ENABLED=true
NOTIFICATIONS_ENABLED=true




FRONTEND_BASE_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
JWT_ISSUER=sophia-authentication
JWT_JSON_WEB_KEY_SET_URI=http://sophia-authentication-api:8080/.well-known/json-web-key-set.json

TRACING_ENABLED=true
OTLP_ENDPOINT=http://sophia-tempo:4318/v1/traces
OTLP_TRACING_ENDPOINT=http://sophia-tempo:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=0.1

MONITORING_USERNAME=prometheus
MONITORING_PASSWORD=prometheus
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# IA (servicio api/ai). Sin GEMINI_API_KEY el servicio arranca pero responde AI_NOT_CONFIGURED.
# AI_PROVIDER=mock devuelve respuestas de ejemplo (solo para trabajar la interfaz).
GEMINI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
AI_ENABLED=true
AI_DAILY_TOKENS_PER_USER=400000
AI_DAILY_TOKENS_PER_WORKSPACE=2000000
