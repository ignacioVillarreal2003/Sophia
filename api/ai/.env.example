# Local overrides for the AI API. Copy to .env (never commit it).
# The key is the only secret; without it the service starts but answers AI_NOT_CONFIGURED.
GEMINI_API_KEY=
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
AI_ENABLED=true
AI_DAILY_TOKENS_PER_USER=400000
AI_DAILY_TOKENS_PER_WORKSPACE=2000000
WORKSPACE_API_URL=http://localhost:8081
